{
  "name": "pixel-news/platform",
  "description": "Pixel News - Arabic News Platform",
  "version": "1.0.0",
  "type": "project",
  "require": {
    "php": "^8.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "PixelNews\\": "api/"
    },
    "files": [
      "api/database.php",
      "api/auth.php"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"copy('.env.example', '.env');\"",
      "@php api/database.php"
    ]
  }
}
