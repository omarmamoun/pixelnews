# Pixel News - Production Environment Configuration
# Copy to .env and fill with real values

# Site Configuration
SITE_URL=https://pixelnews.jo.com
SITE_NAME=Pixel News
ADMIN_EMAIL=admin@pixelnews.jo
APP_ENV=production
APP_DEBUG=false

# Database Configuration (Railway MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=admin
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=pixel_news

# Alternative: Railway provides DATABASE_URL
DATABASE_URL=mysql://user:password@host:3306/database

# Security
ENCRYPTION_KEY=your_encryption_key_32_chars_min
JWT_SECRET=your_jwt_secret_key
ADMIN_PASSWORD_HASH=

# Email Configuration (Optional)
MAIL_FROM=noreply@pixelnews.jo
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Social Media Integration (Optional)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# File Upload
UPLOAD_PATH=uploads/
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Cache Configuration
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# Session Configuration
SESSION_NAME=PIXELNEWS_SESSION
SESSION_LIFETIME=7200

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
MATOMO_SITE_ID=

# Feature Flags
ENABLE_COMMENTS=true
ENABLE_USER_REGISTRATION=true
ENABLE_ARTICLES_SUBMISSION=true
ENABLE_REELS=false
ENABLE_LIVE_STREAMING=false
ENABLE_ADS_SYSTEM=true

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Site is under maintenance. Please try again later.
